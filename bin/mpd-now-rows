#!/usr/bin/env bash
# Emit the now-playing row for the mpd.menu root provider. Labels carry the
# state icon only; clicking the row runs the provider's action (mpc toggle).
# Silent (no rows) when mpd is not running.
set -uo pipefail

status=$(mpc status 2>/dev/null) || exit 0
state=$(awk 'NR==2 {print $1}' <<<"$status")

song=$(mpc current -f '%title%' 2>/dev/null)
[[ -z $song ]] && song=$(mpc current 2>/dev/null)

if [[ $state == "[playing]" ]]; then
  icon="󰐊"   # playing
else
  icon="󰏤"   # paused
fi

if [[ -z $song ]]; then
  printf '%s\t%s\t\n' "󰐊  Play" "toggle"
else
  printf '%s\t%s\t\n' "$icon  $song" "toggle"
fi
